# Environment — real secrets live in .env, never committed.
# The sanitized template .env.example IS committed (negation below).
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# Testing
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/

# Build
dist/
build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Database
*.sqlite3

# App runtime
outbox/

# Misc
*.bak